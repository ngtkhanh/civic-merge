# Copy to apps/api/.env; .env files are not committed.
PORT=3000
HOST=0.0.0.0
MOCK_MODE=true
# Select adapters independently; no automatic fallback on configuration failure.
PERSISTENCE_MODE=memory
STORAGE_PROVIDER=local
AI_PROVIDER=mock
MATCHING_PROVIDER=mock
# Scenario controls/reset only when all four providers are memory/local/mock/mock.
MOCK_SCENARIO=pothole
# Private Supabase Storage (STORAGE_PROVIDER=supabase). Never put these in mobile.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_<backend-secret>
# SUPABASE_STORAGE_BUCKET=civicmerge-evidence
# Required only for the opt-in real Storage test; different private bucket.
# SUPABASE_STORAGE_TEST_BUCKET=civicmerge-evidence-test
# Optional upload scope, one safe path segment. Existing scopes remain readable.
# SUPABASE_STORAGE_PREFIX=evidence
STORAGE_TIMEOUT_MS=10000
# Handed-off OpenAI and GPS/features factories are registered by server/check.
# Set AI_PROVIDER=openai / MATCHING_PROVIDER=real to select them explicitly.
# OPENAI_API_KEY=<backend-only-key>
# OPENAI_MODEL=<model-agreed-with-member-2>
# Same timeout is passed to the adapter (which aborts its upstream fetch).
AI_TIMEOUT_MS=18000
MATCHING_TIMEOUT_MS=3000
# Backend-only PostgreSQL URL from Supabase Connect; set privately in apps/api/.env.
# DATABASE_URL=postgresql://<backend-role>:<encoded-password>@<host>:5432/postgres
# Optional owner URL for db:migrate only (server uses DATABASE_URL).
# MIGRATION_DATABASE_URL=postgresql://<migration-owner>:<encoded-password>@<host>:5432/postgres
# verify (default) validates the server certificate; disable only for local test PostgreSQL.
DATABASE_SSL=verify
# Optional Supabase CA certificate file; no ssl* query parameters in database URLs.
# DATABASE_SSL_CA_FILE=
# Use the laptop LAN address reachable from the iPhone, without a trailing slash.
PUBLIC_BASE_URL=http://192.168.1.100:3000
# Optional. Defaults to <repository>/.runtime/uploads.
# UPLOAD_DIR=
# Optional local script target, for npm run mock:reset.
# MOCK_API_URL=http://127.0.0.1:3000
