# Copy to apps/api/.env; .env files are not committed.
PORT=3000
HOST=0.0.0.0
MOCK_MODE=true
# Use the laptop LAN address reachable from the iPhone, without a trailing slash.
PUBLIC_BASE_URL=http://192.168.1.100:3000
# Optional. Defaults to <repository>/.runtime/uploads.
# UPLOAD_DIR=
# Optional local script target, for npm run mock:reset.
# MOCK_API_URL=http://127.0.0.1:3000
