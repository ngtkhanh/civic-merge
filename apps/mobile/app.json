{
  "expo": {
    "name": "CivicMerge",
    "slug": "civic-merge",
    "scheme": "civicmerge",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "CivicMerge kết nối backend trong mạng nội bộ để gửi báo cáo demo.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "vn.civicmerge.demo",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CivicMerge dùng camera để chụp ảnh minh chứng sự cố.",
          "photosPermission": "CivicMerge dùng ảnh bạn chọn làm minh chứng sự cố.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CivicMerge dùng vị trí để tìm các hồ sơ nghi trùng gần bạn."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cdbbbabf-a108-467a-972d-f2e4780b4b53"
      }
    },
    "owner": "htc_hq"
  }
}
